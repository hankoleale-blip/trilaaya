MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=trikaaya_sports
FRONTEND_ORIGIN=http://localhost:3000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the same strong secret for all backend instances.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRE_MINUTES=60

# Local development defaults. For production set Secure=true.
# Use SameSite=none + Secure=true when frontend/backend are on different sites.
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAMESITE=lax
